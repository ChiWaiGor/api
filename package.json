{
  "name": "cursor-3",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky",
    "build": "nest build api && nest build worker",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "start": "nest start api",
    "start:api": "nest start api",
    "start:worker": "nest start worker",
    "start:dev": "nest start api --watch",
    "start:dev:api": "nest start api --watch",
    "start:dev:worker": "nest start worker --watch",
    "start:debug": "nest start api --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "start:prod:api": "node dist/apps/api/main",
    "start:prod:worker": "node dist/apps/worker/main",
    "lint": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "npm run lint:ci && npm run typecheck && npm run test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "dev:bootstrap": "sh scripts/dev-bootstrap.sh",
    "e2e:prepare": "sh scripts/e2e-prepare.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:seed:catalog": "ts-node --transpile-only prisma/seed-catalog.ts",
    "prisma:seed:admin": "ts-node --transpile-only prisma/seed-admin.ts",
    "prisma:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.0",
    "@sentry/nestjs": "^10.58.0",
    "@sentry/node": "^10.58.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^8.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.(t|j)s",
      "libs/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/shared$": "<rootDir>/libs/shared/src",
      "^@app/shared/(.*)$": "<rootDir>/libs/shared/src/$1",
      "^@app/mail$": "<rootDir>/libs/mail/src",
      "^@app/mail/(.*)$": "<rootDir>/libs/mail/src/$1",
      "^@app/queue$": "<rootDir>/libs/queue/src",
      "^@app/queue/(.*)$": "<rootDir>/libs/queue/src/$1"
    }
  },
  "lint-staged": {
    "{src,apps,libs,test,prisma}/**/*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
