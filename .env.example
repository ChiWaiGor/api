NODE_ENV=development
PORT=3000

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Tune connection_limit per instance so total connections across all running
# instances stays under Postgres max_connections. pool_timeout is in seconds.
# When fronting Postgres with PgBouncer (transaction pooling), point
# DATABASE_URL at PgBouncer and append &pgbouncer=true (and use a DIRECT_URL for
# migrations). Example: ...?schema=public&connection_limit=10&pool_timeout=20
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&connection_limit=10&pool_timeout=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=7d

ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Auth endpoints: register/login use THROTTLE_AUTH_*; refresh uses 2x THROTTLE_AUTH_LIMIT
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10

PERMISSION_CACHE_TTL_SECONDS=300
SESSION_STATE_CACHE_TTL_SECONDS=300

# Brute-force / account-lockout defense. After LOGIN_MAX_FAILED_ATTEMPTS failed
# logins within LOGIN_LOCKOUT_WINDOW_SECONDS, the account is set to LOCKED and a
# password reset is required to regain access.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# Auth lifecycle token lifetimes (single-use, hashed at rest).
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440

# Base URL used to build links in outbound emails (reset/verification).
APP_BASE_URL=http://localhost:3000

# Mail provider. 'log' writes to the app logger; 'smtp' sends via nodemailer.
# For local SMTP testing: docker compose up -d mailpit, set MAIL_TRANSPORT=smtp,
# then open http://localhost:8025 to inspect captured messages.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.com
# SMTP settings (used when MAIL_TRANSPORT=smtp). Defaults match Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD="Admin123!@#"

# Defaults to false. Keep enabled only in dev; leave unset/false in production.
SWAGGER_ENABLED=true

# Host port to publish the app on when running via docker-compose.
APP_PORT=3000
