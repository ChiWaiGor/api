NODE_ENV=development
PORT=3000

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=7d

ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Auth endpoints: register/login use THROTTLE_AUTH_*; refresh uses 2x THROTTLE_AUTH_LIMIT
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10

PERMISSION_CACHE_TTL_SECONDS=300

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD="Admin123!@#"

SWAGGER_ENABLED=true
